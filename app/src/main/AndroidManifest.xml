<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.techma2004.todolist">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name="com.techma2004.todolist.App"
        android:allowBackup="false"
        android:label="Encrypted Todo"
        android:icon="@mipmap/ic_launcher">

        <receiver android:name="com.techma2004.todolist.alarms.AlarmReceiver" />

        <receiver android:name="com.techma2004.todolist.BootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver android:name="com.techma2004.todolist.widget.NextTodoWidget" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/next_todo_widget_info" />
        </receiver>

    </application>
</manifest>
